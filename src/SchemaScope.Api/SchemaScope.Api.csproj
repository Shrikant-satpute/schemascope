<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SchemaScope.Api</RootNamespace>
    <!-- A library, not an exe: the desktop shell hosts it in-process, and a
         self-contained exe cannot reference another executable project. -->
    <OutputType>Library</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- The built React app is baked into this assembly so the shipped exe is
         genuinely one file with no loose web assets beside it. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Off, or the SDK would also copy wwwroot beside the exe as static web
         assets, defeating the point of embedding it. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SchemaScope.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchemaScope.Core\SchemaScope.Core.csproj" />
    <ProjectReference Include="..\SchemaScope.SqlServer\SchemaScope.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vite writes here; whatever is present at build time gets embedded. -->
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Remove="wwwroot\**\*" />
  </ItemGroup>

</Project>
